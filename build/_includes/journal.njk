---
layout: base
title: Journal
id: journal
---

<div class="left flex-column container">
  {{ content | safe }}
</div>

<div class="right flex-column container">
  <div class="box">
    <div class="box-header container">
      <h2>Journal History</h2>
    </div>
    <div class="box-main container journal-list">
      <ul>
        {% for post in collections.journal | reverse %}
          {% if loop.index0 < 20 %}
          <li>
            <a href="post.url">{{ post.data.title }}</a>
            <span class="side">{{ post.data.date | niceDate }}</span>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>

  
  {# Hint: you could put an iShoutbox here with the leaf theme :P #}
</div>

