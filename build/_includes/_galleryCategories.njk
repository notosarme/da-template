<ul class="category-list">
  {% for category in collections.categories %}
    <li>
      <a href="{{ category.url }}">
        <div class="category-card">
          <img src="{{ category.image }}" alt="{{ category.name }}">
          <div class="tag">{{ category.name | title }}</div>
        </div>
      </a>
    </li>
  {% endfor %}
</ul>
