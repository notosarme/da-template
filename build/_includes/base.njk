---
headerTitle: DeviantArt Template
title: Untitled
id: home
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/main.css" />
  <title>{{ title }}</title>
</head>
<body id="{{ id }}">
  <div class="grid">
  <header class="header">
    <div class="title">
      <span class="avatar"></span> {# Remove this if you don't want an icon #}
      <h1><a href="/">{{ headerTitle }}</a></h1>
    </div>
      <nav>
          <ul>
            {# Remove the span classes to remove the icons, or replace the assets for custom ones #}
              <li><span class="icon-info"></span><a class="nav-link" href="/">Home</a></li>
              <li><span class="icon-gallery"></span><a class="nav-link" href="/gallery">Gallery</a></li>
              <li><span class="icon-journal"></span><a class="nav-link" href="/posts">Journal</a></li>
          </ul>
      </nav>
    </header>

    {{ content | safe }}
  </grid>
</body>
</html>